# Valores de demostración local. Cambia la contraseña para otros entornos.
POSTGRES_USER=medisalud
POSTGRES_PASSWORD=medisalud_secret_2026
POSTGRES_DB=medisalud_db
PUBLIC_WEB_URL=http://localhost:5173
# Secreto HMAC para códigos OTP de verificación de correo (MED-29 / MED-30).
# Este valor es solo para demostración local. Fuera de development/test (p. ej. NODE_ENV=production),
# el backend exige un secreto explícito de al menos 32 caracteres aleatorios sin palabras de demostración.
VERIFICATION_HMAC_SECRET=medisalud-demo-hmac-secret-local-only

# Correo opcional con Gmail: descomenta y completa estos valores en .env.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Alternativa opcional de correo con SendGrid.
# SENDGRID_API_KEY=
# SENDGRID_FROM=

# WhatsApp opcional con Twilio.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
