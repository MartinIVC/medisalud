# Copiar a .env y completar en local. No guardar credenciales reales en Git.
POSTGRES_USER=medisalud
POSTGRES_PASSWORD=cambia-esta-clave-local
POSTGRES_DB=medisalud_db

# Ambos valores son necesarios para iniciar sesión como secretaría.
SECRETARY_PASSWORD=cambia-esta-clave
SECRETARY_TOKEN_SECRET=usa-un-secreto-aleatorio-de-al-menos-32-caracteres

PUBLIC_WEB_URL=http://localhost:5173
SENDGRID_API_KEY=
SENDGRID_FROM=
# Alternativa SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

TWILIO_ACCOUNT_SID=
